SET SERVEROUTPUT ON;

DECLARE

    CURSOR dept_cur IS
        SELECT DISTINCT deptno
        FROM emp
        ORDER BY deptno;

    CURSOR emp_cur(p_deptno NUMBER) IS
        SELECT ename, basicsal
        FROM emp
        WHERE deptno = p_deptno;

    v_total_gross NUMBER := 0;
    v_gross       NUMBER;

BEGIN

    FOR d IN dept_cur
    LOOP

        DBMS_OUTPUT.PUT_LINE('Department No: ' || d.deptno);
        DBMS_OUTPUT.PUT_LINE('-----------------------------');

        v_total_gross := 0;

        FOR e IN emp_cur(d.deptno)
        LOOP

            v_gross := e.basicsal
                     + (e.basicsal * 0.50)
                     + (e.basicsal * 0.15)
                     + 500
                     - (e.basicsal * 0.10);

            DBMS_OUTPUT.PUT_LINE(
                'Name: ' || e.ename ||
                '  Basic Salary: ' || e.basicsal ||
                '  Gross Salary: ' || v_gross
            );

            v_total_gross := v_total_gross + v_gross;

        END LOOP;

        DBMS_OUTPUT.PUT_LINE(
            'Department Total Gross Salary: ' || v_total_gross
        );

        DBMS_OUTPUT.PUT_LINE(' ');

    END LOOP;

END;
/
